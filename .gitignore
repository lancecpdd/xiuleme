# Python 转换脚本用的原始模型权重（不随应用分发）
src-tauri/resources/*.pth
src-tauri/resources/*.pt
src-tauri/resources/*.pb
src-tauri/gen/*
!src-tauri/gen/android/
# Ignore Android assets generated by Tauri
src-tauri/gen/android/app/src/main/assets/
src-tauri/libs/

**/keystore.properties
**/keystore.jks
**/key.properties

# bench/replay.js result dumps
bench/out/

# Python 离线工具脚本（仅用于生成/验证 ONNX 模型与维护翻译，不参与应用构建和运行）
scripts/
!native/portrait-engine/scripts/
src/i18n/update_translations.py
__pycache__/
*.pyc

# 第三方研究参考材料与验证输出（仅本地手动测试使用）
.research/

# 本地 Python/OpenCV/MediaPipe 美颜等实验沙箱（不入库）
experiments/

# GPUPixel 社区 wrapper 离线工具：上游 clone 与编出的 DLL（脚本与 vendor/pywrapper 可入库）
tools/gpupixel-ref/vendor/gpupixel/
tools/gpupixel-ref/output/

# 调试/验证输出的临时转储（本地排查用，不入库）
/tmp-*.txt
